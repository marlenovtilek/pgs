APP_NAME=PGS (Parking Guidance Service)
DEBUG=true
PYTHONUNBUFFERED=1
DATABASE_URL=postgresql+psycopg2://pgs:pgs@pgs-db:5432/pgs
MQTT_HOST=smartparking-emqx
MQTT_PORT=1883
MQTT_CLIENT_ID=pgs-mqtt-listener
AUTH_SECRET_KEY=change-this-secret-in-production
AUTH_COOKIE_NAME=pgs_auth
AUTH_COOKIE_MAX_AGE=604800
AUTH_COOKIE_SECURE=false
AUTH_REGISTRATION_ENABLED=false
API_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
LED_ADAPTER=mock
LED_HTTP_PATH=/api/v1/led/commands
LED_HTTP_TIMEOUT=3.0
# Comma-separated spot codes marked as disabled/special (new format only).
# Leave empty to use the built-in default in app/services/spots.py.
# DISABLED_SPOT_CODES=B1-B-01-1,B1-B-01-2,B1-B-02-1
# Port where the MQTT consumer exposes Prometheus metrics (API exposes /metrics on its own port).
METRICS_PORT=9101

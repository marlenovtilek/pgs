# ============================================================================
# PGS — шаблон production .env
# ----------------------------------------------------------------------------
# НЕ коммить реальные секреты. Скопируй этот файл в .env (он в .gitignore) и
# подставь настоящие значения:
#     cp .env.production.example .env
#
# Сгенерировать сильные секреты:
#     openssl rand -hex 32     # для AUTH_SECRET_KEY
#     openssl rand -hex 24     # для API_TOKEN
#     openssl rand -base64 24  # для ADMIN_PASSWORD / пароля БД
#
# Перед запуском пройди чеклист внизу файла.
# ============================================================================

# ---- Приложение ------------------------------------------------------------
APP_NAME=PGS (Parking Guidance Service)
# В проде выключаем debug: без traceback наружу и без авто-reload.
DEBUG=false
PYTHONUNBUFFERED=1

# ---- База данных -----------------------------------------------------------
# Заведи отдельного пользователя с сильным паролем (не pgs:pgs).
DATABASE_URL=postgresql+psycopg2://pgs_prod:CHANGE_ME_DB_PASSWORD@pgs-db:5432/pgs

# ---- MQTT ------------------------------------------------------------------
MQTT_HOST=CHANGE_ME_BROKER_HOST
MQTT_PORT=1883
MQTT_CLIENT_ID=pgs-mqtt-listener
MQTT_KEEPALIVE=60
# Если брокер требует авторизацию (в проде — обычно да):
MQTT_USERNAME=CHANGE_ME_MQTT_USER
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD

# ---- Аутентификация и безопасность -----------------------------------------
# openssl rand -hex 32
AUTH_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
AUTH_COOKIE_NAME=pgs_auth
AUTH_COOKIE_MAX_AGE=604800
# ОБЯЗАТЕЛЬНО true, если сервис за HTTPS (cookie не уйдёт по http).
AUTH_COOKIE_SECURE=true
# Публичную регистрацию в проде держим выключенной.
AUTH_REGISTRATION_ENABLED=false

# Токен для protected REST API (Authorization: Bearer <API_TOKEN>).
# Пустое значение ОТКЛЮЧАЕТ проверку — в проде так нельзя.
# openssl rand -hex 24
API_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL

# Первый администратор админки (создаётся pgs-admin-bootstrap).
ADMIN_USERNAME=admin
# openssl rand -base64 24
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---- LED -------------------------------------------------------------------
# Пока нет реального vendor-адаптера (нужен protocol/API от поставщика):
#   mock — ничего не шлёт наружу, только пишет LedCommandLog (безопасный дефолт);
#   http — POST на host:port LED-устройства (для реального HTTP-контроллера/fake-led).
LED_ADAPTER=mock
LED_HTTP_PATH=/api/v1/led/commands
LED_HTTP_TIMEOUT=3.0

# ---- Прочее ----------------------------------------------------------------
# Список спец/выключенных мест (новый формат), через запятую. Пусто — дефолт из кода.
# DISABLED_SPOT_CODES=B1-B-01-1,B1-B-01-2
# Порт Prometheus-метрик MQTT consumer (у API метрики на /metrics).
METRICS_PORT=9101

# ============================================================================
# ЧЕКЛИСТ ПЕРЕД ДЕПЛОЕМ
# ----------------------------------------------------------------------------
# [ ] DEBUG=false
# [ ] AUTH_SECRET_KEY заменён (openssl rand -hex 32)
# [ ] API_TOKEN заменён и НЕ пустой
# [ ] ADMIN_PASSWORD заменён на сильный
# [ ] DATABASE_URL — отдельный пользователь и сильный пароль
# [ ] MQTT_USERNAME / MQTT_PASSWORD заданы, если брокер требует auth
# [ ] AUTH_COOKIE_SECURE=true (если HTTPS)
# [ ] LED_ADAPTER осознанно выбран (mock до получения vendor API)
# [ ] pgs-fake-led убран из дефолтного compose (вернуть под --profile fake-led)
# [ ] .env НЕ в git (проверь: git check-ignore .env)
# ============================================================================
